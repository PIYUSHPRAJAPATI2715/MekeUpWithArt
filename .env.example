# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# DATABASE
MONGODB_URI=mongodb://127.0.0.1:27017/makeupwithart

# AUTHENTICATION
JWT_SECRET=makeup_with_art_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=makeup_with_art_refresh_token_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# OPENAI AI IMAGE GENERATION (DALL-E 3)
OPENAI_API_KEY=your_openai_api_key_here

# EMAIL / SMTP SETUP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=makeupwitharto@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM="MAKEUP WITH ART" <makeupwitharto@gmail.com>

# WHATSAPP CLOUD API / TWILIO
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# CLOUDINARY FILE STORAGE (OPTIONAL)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# RAZORPAY PAYMENT (OPTIONAL)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# GOOGLE MAPS
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
